      "id": "38fffab1-20f9-4e3c-b909-22e96384fe42",
      "name": "Transcribir con Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        6592,
        1904
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Modo: Run Once for Each Item.\n// El webservice de whisper marca la respuesta como text/plain segun la\n// version, y entonces n8n no la parsea: deja el JSON entero como string en\n// json.data. Esto cubre los tres casos sin tener que adivinar cual toca.\n\nconst j = $json;\nlet texto = '';\n\nif (typeof j.text === 'string') {\n  texto = j.text;                            // n8n lo parseo bien\n} else if (typeof j.data === 'string') {\n  try {\n    texto = JSON.parse(j.data).text ?? '';   // JSON sin parsear\n  } catch (e) {\n    texto = j.data;                          // output=txt, texto pelado\n  }\n}\n\nreturn { json: { transcripcion: String(texto).trim() } };\n"
      },
