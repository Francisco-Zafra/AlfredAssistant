      "id": "c0c24dbd-c13a-48bc-9563-f34902862fec",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        7472,
        2128
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Modo: Run Once for Each Item.\n// Junta la transcripcion cruda con la salida del modelo y arma el .md.\n\nconst cruda = String($('Normalizar transcripcion').item.json.transcripcion ?? '').trim();\n\nconst meta = $('Filtrar y normalizar').item.json;\n\n// El modelo deberia devolver JSON pelado, pero a veces lo envuelve en vallas.\nfunction parsearJson(s) {\n  const t = String(s ?? '').trim()\n    .replace(/^```(?:json)?/i, '')\n    .replace(/```$/, '')\n    .trim();\n  try { return JSON.parse(t); } catch (e) { /* probamos a recortar */ }\n  const i = t.indexOf('{');\n  const f = t.lastIndexOf('}');\n  if (i !== -1 && f > i) {\n    try { return JSON.parse(t.slice(i, f + 1)); } catch (e) { /* nos rendimos */ }\n  }\n  return null;\n}\n\nconst modelo = parsearJson($json.text ?? $json.response ?? '') ?? {};\n\n// Si el modelo falla, la nota se guarda igual con la transcripcion cruda.\n// Perder la nota seria peor que guardarla fea.\nconst limpio = String(modelo.limpio ?? cruda).trim();\nlet titulo = String(modelo.titulo ?? cruda.split(/\\s+/).slice(0, 8).join(' ')).trim();\ntitulo = titulo.replace(/\\s+/g, ' ').slice(0, 80) || 'Nota sin titulo';\n\nconst slug = titulo\n  .normalize('NFD').replace(/[^\\x00-\\x7F]/g, '')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '')\n  .slice(0, 50) || 'nota';\n\nconst creado = DateTime.fromISO(meta.fecha).setZone('Europe/Madrid');\nconst nombreFichero = creado.toFormat('yyyy-LL-dd-HHmm') + '-' + slug + '.md';\n\nconst tituloYaml = '\"' + titulo.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"') + '\"';\nconst crudaCitada = (cruda || '(transcripcion vacia)')\n  .split('\\n').map(l => '> ' + l).join('\\n');\n\nconst contenido = [\n  '---',\n  'tipo: nota',\n  'titulo: ' + tituloYaml,\n  'creado: ' + creado.toFormat(\"yyyy-LL-dd'T'HH:mm:ss\"),\n  'cuando:',\n  'avisado: false',\n  'tags: []',\n  '---',\n  '',\n  '# ' + titulo,\n  '',\n  limpio,\n  '',\n  '<!-- transcripcion cruda -->',\n  crudaCitada,\n  '',\n].join('\\n');\n\nreturn {\n  json: {\n    nombreFichero,\n    titulo,\n    contenido,\n    chat_id: meta.chat_id,\n    message_id: meta.message_id,\n    modeloOk: Object.keys(modelo).length > 0,\n  },\n};\n"
      },
