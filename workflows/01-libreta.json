    {
      "parameters": {
        "jsCode": "// El offset marca el ultimo update ya procesado. Vive en el almacen estatico\n// del workflow, asi que sobrevive a reinicios de n8n.\nconst estado = $getWorkflowStaticData('global');\nreturn [{ json: { offset: estado.telegramOffset ?? 0 } }];\n"
      },
      "id": "bd0507c1-095f-4b04-9f85-dc5abe3e9067",
      "name": "Leer offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5264,
        2048
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\"]"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "86da87fd-241b-4344-8cc7-120f69dff260",
      "name": "getUpdates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        5488,
        2048
      ]
    },
    {
      "parameters": {
        "jsCode": "// Puerta de entrada. El id permitido llega por variable de entorno del\n// contenedor (TELEGRAM_ALLOWED_USER_ID en .env).\nconst PERMITIDO = Number($env.TELEGRAM_ALLOWED_USER_ID);\n\nif (!Number.isFinite(PERMITIDO) || PERMITIDO === 0) {\n  throw new Error('TELEGRAM_ALLOWED_USER_ID no esta definido en el contenedor de n8n');\n}\n\nconst estado = $getWorkflowStaticData('global');\nconst respuesta = $input.first().json;\n\nif (!respuesta.ok || !respuesta.result || respuesta.result.length === 0) {\n  return [];\n}\n\nconst updates = respuesta.result;\n\n// Avanzamos el offset ANTES de procesar: si no, un poll que entra mientras se\n// transcribe un audio largo volveria a coger el mismo mensaje.\n// Precio: si n8n se cae a mitad, ese mensaje se pierde.\n// Ver docs/telegram-polling.md\nestado.telegramOffset = Math.max(...updates.map(u => u.update_id)) + 1;\n\nconst salida = [];\n\nfor (const u of updates) {\n  const msg = u.message;\n  if (!msg) continue;\n  if (msg.from?.id !== PERMITIDO) continue;\n\n  salida.push({\n    json: {\n      update_id: u.update_id,\n      chat_id: msg.chat.id,\n      message_id: msg.message_id,\n      fecha: new Date(msg.date * 1000).toISOString(),\n      tipo: msg.voice ? 'voz' : (msg.text ? 'texto' : 'otro'),\n      texto: msg.text ?? null,\n      voice_file_id: msg.voice?.file_id ?? null,\n      voice_duracion: msg.voice?.duration ?? null,\n    },\n  });\n}\n\nreturn salida;\n"
      },
