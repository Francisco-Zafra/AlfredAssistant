# Copia este fichero a .env y rellénalo. .env NO va al repo.

# Clave de cifrado de credenciales de n8n.
# Génerala una vez con:  openssl rand -hex 32
# Si la pierdes o la cambias, hay que volver a meter todas las credenciales a mano.
N8N_ENCRYPTION_KEY=

# Token del bot, te lo da @BotFather en Telegram.
# docker-compose se lo pasa al contenedor de n8n y los workflows lo leen como
# {{ $env.TELEGRAM_BOT_TOKEN }}. No es una credencial de n8n: la API de Telegram
# lleva el token en la ruta de la URL y las credenciales no saben ponerlo ahí.
TELEGRAM_BOT_TOKEN=

# Tu user id numérico de Telegram. Te lo dice @userinfobot.
# El bot ignora cualquier mensaje que no venga de aquí.
TELEGRAM_ALLOWED_USER_ID=

# --- Lo siguiente NO lo lee docker-compose ---
# Va dentro de n8n, como credencial del nodo del modelo.

# API key de Gemini, desde Google AI Studio.
# Se mete a mano en n8n: Credentials -> Google Gemini(PaLM) Api.
# Ojo: el tier gratuito tiene un tope DIARIO de peticiones por modelo, y cada
# nota de voz gasta una. Mira el límite real de tu proyecto en ai.dev/rate-limit.
# GEMINI_API_KEY=

# API key de OpenRouter, desde openrouter.ai/keys.
# Es la reserva: si Gemini se queda sin cuota, el workflow reintenta por aquí
# con un modelo :free. También se mete a mano como credencial en n8n.
# OPENROUTER_API_KEY=
